<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable
            name="userInfo"
            type="com.hc.dat.model.database.entity.UserEntity" />
        <variable
            name="extraCamera"
            type="Boolean" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:padding="20dp"
        android:background="#B7000000"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginEnd="20dp"
                android:orientation="vertical">
                <!--            <TextView-->
                <!--                android:layout_width="wrap_content"-->
                <!--                android:layout_height="wrap_content"-->
                <!--                android:textColor="@color/orange"-->
                <!--                android:textSize="30sp"-->
                <!--                android:layout_marginTop="10dp"-->
                <!--                android:layout_marginBottom="20dp"-->
                <!--                android:id="@+id/tvTitleFinger"-->
                <!--                android:text="Mẫu khuôn mặt xác thực"-->
                <!--                android:textStyle="bold" />-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/ivRecog1"
                        android:layout_width="150dp"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_face_recog"/>
                    <ImageView
                        android:id="@+id/ivRecog2"
                        android:layout_width="150dp"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_face_recog"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/ivRecog3"
                        android:layout_width="150dp"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_face_recog"/>
                    <ImageView
                        android:id="@+id/ivRecog4"
                        android:layout_width="150dp"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_face_recog"/>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/ivRecog5"
                        android:layout_width="150dp"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_face_recog"/>
                    <ImageView
                        android:id="@+id/ivRecog6"
                        android:layout_width="150dp"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_face_recog"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btReset"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="20dp"
                    android:background="@color/gray"
                    android:backgroundTint="@color/gray"
                    android:text="@string/rfr_reset_bt"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:ignore="TextContrastCheck" />
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/rlCameraPreview"
                android:layout_width="500dp"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/flCameraView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#ff000000"
                    android:visibility="visible"
                    android:gravity="center">
                    <com.lws.device.camerapreview.sample.InternalCameraPreview
                        android:id="@+id/previewCamera"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="@{(extraCamera == true) ? View.GONE : View.VISIBLE}"
                        android:layout_gravity="center" />
                    <com.serenegiant.widget.AspectRatioSurfaceView
                        android:id="@+id/surfaceView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fitsSystemWindows="true"
                        android:visibility="@{(extraCamera == true) ? View.VISIBLE : View.GONE}"
                        android:layout_gravity="center" />
                    <hc.manager.datapp.camera.FaceView
                        android:id="@+id/faceView"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent" />
                    <View
                        android:layout_width="200dp"
                        android:layout_height="450dp"
                        android:layout_gravity="center"
                        android:background="@drawable/border_color_5"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/tvGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/orange"
                    android:background="@color/white"
                    android:alpha="0.7"
                    android:textSize="30sp"
                    android:layout_centerHorizontal="true"
                    android:text="NHÌN VÀO CAMERA ĐỂ TẠO NHẬN DẠNG"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btCapture"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    app:icon="@drawable/iconcamera"
                    app:iconGravity="start"
                    app:iconSize="40dp"
                    android:visibility="@{(userInfo == null) ? View.GONE : View.VISIBLE}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    app:backgroundTint="@color/blue"
                    android:layout_marginBottom="5dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:text="@string/rfr_capture_bt"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/btRotateCamera"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_rotate_camera"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    app:backgroundTint="@color/blue"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="5dp"
                    android:textSize="22sp"
                    />
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="340dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:visibility="@{(userInfo != null) ? View.GONE : View.VISIBLE}"
                    android:layout_gravity="top"
                    android:layout_marginLeft="10dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/orange"
                        android:textSize="25sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="Nhập mã code/Số CCCD"
                        android:textStyle="bold" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/edtUserCode"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/dialog_bg"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:inputType="text"
                            android:lines="1"
                            android:maxLength="50"
                            android:singleLine="true"
                            android:textSize="20sp"
                            tools:ignore="SpeakableTextPresentCheck" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btCheck"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="@string/tls_check_bt"
                        android:background="@color/orange"
                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="@{(userInfo != null) ? View.VISIBLE : View.GONE}"
                    android:layout_gravity="top"
                    android:padding="10dp"
                    android:gravity="center_horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CÀI ĐẶT NHẬN DẠNG"
                            android:textAlignment="center"
                            android:textColor="@color/orange"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:gravity="center_horizontal" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="5"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="Họ và tên: "
                                android:textColor="@color/white"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="3"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="5"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="Mã người dùng: "
                                android:textColor="@color/white"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvUserCode"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="3"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="5"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="Số điện thoại: "
                                android:textColor="@color/white"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvPhoneNumber"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="3"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="5"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="Số CMT: "
                                android:textColor="@color/white"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvIdentifyNumber"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="3"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:gravity="center"
                        android:layout_gravity="center">

                        <ProgressBar
                            android:id="@+id/progress_bar"
                            style="@style/CircularDeterminateProgessBar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminateOnly="false"
                            android:max="100"
                            android:min="0"
                            android:progressDrawable="@drawable/circle"
                            tools:progress="0" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvProgress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0%"
                                android:textColor="@color/green"
                                android:textSize="25sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <Button
                        android:id="@+id/btCancel"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="20dp"
                        android:background="@color/gray"
                        android:backgroundTint="@color/gray"
                        android:text="@string/rfr_back_bt"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:ignore="TextContrastCheck" />
                    <Button
                        android:id="@+id/btUploadFaceRecognize"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="@string/rfr_upload_face_recog_bt"
                        android:background="@color/orange"
                        android:textColor="@color/white"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>