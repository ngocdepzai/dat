<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dialog_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dialog_title_margin"
        android:layout_marginEnd="@dimen/dialog_title_margin"
        android:layout_marginTop="@dimen/dialog_title_margin"
        android:text="Title"
        android:textColor="@color/gray_dark"
        android:textSize="@dimen/dialog_title_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dialog_message_margin"
        android:layout_marginEnd="@dimen/dialog_message_margin"
        android:layout_marginTop="@dimen/dialog_message_margin"
        android:text="Message\nMessage"
        android:textColor="@color/gray_dark"
        android:textSize="@dimen/dialog_message_text" />

    <!--
    Add RecyclerView into RelativeLayout
    because we have an issue with android:layout_gravity="end"
    ->item list did not showing when items have size under 3 items
    -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dialogButtonList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/dialog_button_margin_end"
            tools:listitem="@layout/dialog_button_item" />
    </RelativeLayout>
</LinearLayout>