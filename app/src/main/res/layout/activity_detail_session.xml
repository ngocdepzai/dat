<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.DetailSessionActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:text="THÔNG TIN PHIÊN HỌC"
                android:textSize="25sp"
                android:layout_height="100px"></TextView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="300dp"
                        android:layout_marginLeft="4dp"
                        android:layout_gravity="center"
                        android:id="@+id/ivStudentLogin"
                        android:layout_marginTop="8dp"
                        android:layout_height="300dp"></ImageView>
                    <TextView
                        android:layout_width="match_parent"
                        android:text="Thời điểm đăng nhập: "
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="25sp"
                        android:layout_height="100px"></TextView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="300dp"
                        android:layout_marginLeft="4dp"
                        android:id="@+id/ivStudentLogout"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:layout_height="300dp"></ImageView>
                    <TextView
                        android:layout_width="match_parent"
                        android:text="Thời điểm đăng xuất: "
                        android:gravity="center"
                        android:textSize="25sp"
                        android:layout_height="100px"></TextView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="2"></LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>