<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="android.view.View"/>
        <variable
            name="userEntity"
            type="com.hc.dat.model.database.entity.UserEntity" />
        <variable
            name="extraCamera"
            type="Boolean" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="20dp"
        android:background="#B7000000"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/rlCameraPreview"
                android:layout_width="450dp"
                android:layout_height="550dp">

                <FrameLayout
                    android:id="@+id/flCameraView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#ff000000"
                    android:visibility="visible"
                    android:gravity="center">
<!--                    <hc.manager.datapp.camera.CameraPreview-->
<!--                        android:id="@+id/previewCamera"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="match_parent"-->
<!--                        android:layout_gravity="center" />-->
                    <com.lws.device.camerapreview.sample.InternalCameraPreview
                        android:id="@+id/previewCamera"
                        android:visibility="@{(extraCamera == true) ? View.GONE : View.VISIBLE}"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />
                    <com.serenegiant.widget.AspectRatioSurfaceView
                        android:id="@+id/surfaceView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fitsSystemWindows="true"
                        android:visibility="@{(extraCamera == true) ? View.VISIBLE : View.GONE}"
                        android:layout_gravity="center" />
                    <hc.manager.datapp.camera.FaceView
                        android:id="@+id/faceView"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/orange"
                    android:background="@color/white"
                    android:alpha="0.7"
                    android:textSize="25sp"
                    android:layout_centerHorizontal="true"
                    android:text="NHÌN VÀO CAMERA KHI ĐĂNG NHẬP"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textStyle="bold" />
            </RelativeLayout>

            <ScrollView
                android:layout_width="500dp"
                android:layout_height="match_parent"
                android:scrollbars="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
<!--                    HC1-15  turn off auto detect -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btAutoDetect"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:text="@string/rfr_auto_detect_bt"
                        android:background="@color/orange"
                        android:textColor="@color/black"
                        android:visibility="gone"
                        android:textSize="18sp"
                        android:textStyle="bold">
                    </androidx.appcompat.widget.AppCompatButton>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:visibility="@{(userEntity != null) ? View.GONE : View.VISIBLE}"
                        android:layout_gravity="top"
                        android:layout_marginLeft="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvAddUserLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/orange"
                            android:textSize="25sp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:visibility="gone"
                            android:text="THÊM NHẬN DIỆN NGƯỜI DÙNG"
                            android:textAlignment="center"
                            android:maxLines="1"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:text="Hoặc"
                            android:visibility="gone"
                            android:textAlignment="center"
                            android:maxLines="1"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/orange"
                            android:textSize="25sp"
                            android:layout_marginBottom="10dp"
                            android:text="Tìm kiếm theo\nMã code | Số CCCD"
                            android:textAlignment="center"
                            android:textStyle="bold" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/edtUserCode"
                            android:focusable="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/dialog_bg"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:inputType="text"
                                android:lines="1"
                                android:maxLength="50"
                                android:singleLine="true"
                                android:textSize="18sp"
                                tools:ignore="SpeakableTextPresentCheck" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btCheck"
                            android:layout_width="match_parent"
                            android:layout_marginTop="10dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:text="@string/tls_check_bt"
                            android:background="@color/orange"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:visibility="@{(userEntity != null) ? View.VISIBLE : View.GONE}"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/orange"
                            android:textSize="25sp"
                            android:layout_marginTop="10dp"
                            android:id="@+id/tvTitleFinger"
                            android:textAlignment="center"
                            android:maxLines="1"
                            android:text="Mẫu khuôn mặt xác thực"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivFaceSampleRecog"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_marginEnd="10dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_loading"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:layout_gravity="center_horizontal"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvFullnameTeacher"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/user_name_text"
                                android:text="@{userEntity.fullName ?? `-/-`}"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvIdNoTeacher"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/user_other_info_text"
                                android:text="@{userEntity.userCode ?? `-/-`}"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvBirthDayTeacher"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/user_other_info_text"
                                android:text="@{userEntity.birthday ?? `-/-`}"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/orange"
                            android:textSize="20sp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:textAlignment="center"
                            android:visibility="gone"
                            android:text="Vui lòng nhìn vào camera để thực hiện xác thực khuôn mặt"
                            android:textStyle="italic" />
                        <Button
                            android:id="@+id/btCancel"
                            android:layout_width="match_parent"
                            android:layout_marginTop="10dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:text="@string/rfr_back_bt"
                            android:background="@color/orange"
                            android:textColor="@color/black"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </LinearLayout>
</layout>
